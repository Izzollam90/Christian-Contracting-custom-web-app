# Copy to .env.local and fill in. Never commit .env.local.
# Front end (safe to expose to the browser)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_COMPANY_NAME=Herkey Maintenance
VITE_TIMEZONE=America/New_York

# Scripts only (seeding users). NEVER ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google and Apple sign-in are configured inside Supabase → Authentication → Providers,
# not here. Redirect/callback URL for both: https://YOUR-PROJECT.supabase.co/auth/v1/callback
