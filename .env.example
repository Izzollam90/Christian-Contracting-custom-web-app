# Copy to .env.local and fill in. Never commit .env.local. NEVER paste keys into chat/issues.
# If a key is ever shared by mistake: Supabase -> Project Settings -> API -> rotate it immediately.
#
# Front end (safe to expose to the browser) — Supabase -> Project Settings -> API:
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the "anon" key, or the newer "publishable" key (sb_publishable_...) — both are browser-safe.
VITE_SUPABASE_ANON_KEY=
VITE_COMPANY_NAME=Herkey Maintenance
VITE_TIMEZONE=America/New_York

# Scripts only (seeding users). NEVER ship to the browser.
# This is the "secret" key (sb_secret_...) or legacy "service_role" key — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Google sign-in is configured inside Supabase -> Authentication -> Providers,
# not here. Redirect/callback URL: https://YOUR-PROJECT.supabase.co/auth/v1/callback
# Passkeys and MFA (TOTP) are enabled in Supabase -> Authentication -> Settings.
